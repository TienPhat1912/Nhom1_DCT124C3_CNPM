# Values use KEY=value without quotes. Generated passwords are recommended.
SQL_PASSWORD=REPLACE_WITH_A_RANDOM_STRONG_PASSWORD
DEMO_PASSWORD=REPLACE_WITH_A_RANDOM_DEMO_PASSWORD
SQL_PORT=14339
API_PORT=5280
WEB_PORT=5180
DATABASE_NAME=HospitalGuidance
