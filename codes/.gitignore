# Keep the application safe to share even when codes/ is copied on its own.
# Templates, package-lock.json, packages.lock.json, migrations, Dockerfiles,
# Compose files, scripts, tests and app assets are required for a fresh build.
# The GitHub Actions workflow lives at ../.github/workflows/check.yml.

# Per-machine configuration and credentials; example files remain public.
.env
.env.*
!.env.example
!.env.*.example
.local/
*.pem
*.key
*.pfx
*.p12
*.p8
*.jks
*.keystore
*.mobileprovision

# Local SDKs, runtime state and generated output.
.gradle-cache/
**/.gradle/
**/.cxx/
**/__pycache__/
*.py[cod]
**/bin/
**/obj/
**/node_modules/
**/dist/
**/.expo/
**/web-build/
**/coverage/
*.tsbuildinfo
apps/mobile/android/
apps/mobile/ios/
**/test-results/
**/playwright-report/
*.user
*.log
*.pid
artifacts/
*.apk
*.aab

# Local SQL Server files and backups; schema is shared through migrations.
*.mdf
*.ndf
*.ldf
*.bak

# Historical generated reports (new runs write to artifacts/).
/docs/evidence/
/docs/reports/

# Retired files are kept locally; only the archive index is published.
/archive/*
!/archive/README.md
!/archive/MANIFEST.md

# Editor and OS files.
.vs/
.idea/
*.suo
.DS_Store
Thumbs.db
