{
  "name": "hospital-guidance",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10.9.3 <11"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hospital/web",
    "build": "npm run build --workspace @hospital/web",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run test:contracts",
    "test:contracts": "tsc --project tests/contracts/tsconfig.json",
    "lint": "eslint apps packages tests --max-warnings 0",
    "test:e2e": "playwright test",
    "test:map": "playwright test --config playwright.map.config.ts",
    "test:map:unit": "node --experimental-strip-types --test tests/unit/hospital-map.test.mjs tests/unit/map-layout.test.mjs tests/unit/native-map.test.mjs",
    "test:position:unit": "node --experimental-strip-types --test tests/unit/position-source.test.mjs tests/unit/native-position.test.mjs",
    "test:demo": "node tests/api/demo-smoke.mjs",
    "mobile": "npm run start --workspace @hospital/mobile",
    "test:directory": "playwright test --config playwright.directory.config.ts",
    "test:directory:unit": "node --experimental-strip-types --test tests/unit/hospital-directory.test.mjs",
    "test:narration:unit": "node --test tests/unit/native-narration.test.mjs tests/unit/native-journey-narration.test.mjs",
    "test:narration:web": "playwright test --config playwright.narration.config.ts",
    "test:journey:native": "node --test tests/unit/native-journey.test.mjs",
    "test:session:unit": "node --test tests/unit/native-session.test.mjs",
    "test:results:native": "node --test tests/unit/native-results.test.mjs",
    "test:reception:unit": "node --test tests/unit/native-reception.test.mjs",
    "test:languages:unit": "node --experimental-strip-types --test tests/unit/languages.test.mjs",
    "test:translation": "dotnet run --project tests/translation/Translation.Tests.csproj"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.7",
    "typescript": "6.0.3",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.2",
    "prettier": "3.9.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
