{
  "name": "hospital-guidance",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10.9.3 <11"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hospital/web",
    "build": "npm run build --workspace @hospital/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages tests --max-warnings 0",
    "test:e2e": "playwright test",
    "test:demo": "node tests/api/demo-smoke.mjs",
    "mobile": "npm run start --workspace @hospital/mobile"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.7",
    "typescript": "6.0.3",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.2",
    "prettier": "3.9.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
