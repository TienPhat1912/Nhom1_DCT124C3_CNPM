{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    "Enabled": false
  },
  "Workflow": {
    "PrdV2Enabled": false
  },
  "Providers": {
    "Mode": "Simulation",
    "TimeoutSeconds": 5,
    "FailureMode": "None"
  },
  "Web": {
    "Origin": "http://localhost:5180"
  },
  "Access": {
    "GuestHours": 24,
    "AccountHours": 8,
    "QrHours": 24
  },
  "Presence": {
    "HeartbeatSeconds": 15,
    "TtlSeconds": 60
  },
  "Translation": {
    "Provider": "Dictionary",
    "TimeoutSeconds": 5,
    "CacheMinutes": 60,
    "CacheVersion": "1",
    "MaxAttempts": 2,
    "RetryDelayMilliseconds": 100
  }
}
