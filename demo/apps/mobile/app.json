{
  "expo": {
    "name": "Hospital Patient Guide",
    "slug": "hospital-patient-guide",
    "version": "1.0.0",
    "scheme": "hospitalguide",
    "orientation": "portrait",
    "android": {
      "package": "edu.demo.hospitalguide"
    },
    "ios": {
      "bundleIdentifier": "edu.demo.hospitalguide"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow scanning hospital examination tickets",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
