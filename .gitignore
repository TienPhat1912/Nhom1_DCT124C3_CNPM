# Shared rules for the whole repository, including codes/.
# Source, lockfiles, Docker/CI configuration, scripts and assets stay tracked.

# Dependencies and generated frontend output.
node_modules/
.expo/
dist/
web-build/
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# Per-machine configuration. Commit templates, never generated credentials.
.env
.env.*
!.env.example
!.env.*.example
.local/

# Private certificates and signing keys.
*.pem
*.key
*.pfx
*.p12
*.p8
*.jks
*.keystore
*.mobileprovision

# Logs and process state.
*.log
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS files.
.vs/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db

# Retired local demo; the maintained application is in codes/.
/demo/
