        <mxCell id="notes" value="Drafts are never returned to the patient. Review/replay does not require an Active Visit or Journey, only authorized access and Published content. A correction replaces the current published version and invalidates obsolete current-audio references; follow-up remains separate." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDF1;strokeColor=#C9B970;fontFamily=Arial;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
