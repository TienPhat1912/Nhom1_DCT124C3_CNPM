          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Pharmacy remains: retain guidance&lt;br&gt;and do not deny access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;" edge="1" parent="1" source="closed" target="jactive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state_notes" value="If pharmacy guidance remains before the first scan, Journey stays Pending Activation until an authorized scan. If already Active, it stays Active. Final settlement includes an authorized no-payment-required outcome; required clinical work must still be resolved. Visit closure never asserts medication dispensing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDF1;strokeColor=#C9B970;fontFamily=Arial;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="1320" width="1480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="identity_notes" value="No state change solely from browser/app closure, session expiry, repeated QR scan or guest-to-account linking. Records remain stored. A later attendance creates a new Visit and Journey after a new reception confirmation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDF1;strokeColor=#C9B970;fontFamily=Arial;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="1510" width="1480" height="130" as="geometry" />
        </mxCell>
