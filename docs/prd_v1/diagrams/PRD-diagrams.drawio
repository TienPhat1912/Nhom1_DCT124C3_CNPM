              <mxPoint x="90" y="740" />
              <mxPoint x="405" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="Required clinical work resolved&lt;br&gt;AND current final settlement confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="active" target="closed">
          <mxGeometry relative="1" as="geometry" />
