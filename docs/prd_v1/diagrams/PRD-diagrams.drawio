          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Visit Closed AND&lt;br&gt;(no pharmacy guidance OR patient confirms&lt;br&gt;eligible final pharmacy guidance)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="jactive" target="completed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
